{
    "name": "linklite",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "next dev",
        "build": "next build",
        "build:worker": "tsc -p tsconfig.worker.json",
        "start": "next start",
        "lint": "eslint",
        "typecheck": "tsc --noEmit",
        "worker:domain-enrichment_local": "dotenv -e .env -- tsx worker/domain_enrichment_worker.ts",
        "test": "vitest",
        "test:run": "vitest run",
        "test:watch": "vitest",
        "test:unit": "vitest run -c vitest.unit.config.ts",
        "test:integration": "vitest run -c vitest.integration.config.ts",
        "test:ui": "vitest run -c vitest.ui.config.ts",
        "test:integration-local": "export RUN_WHOIS_INTEGRATION=1 && docker compose --env-file .env.test up -d db && bash -lc 'set -a; source .env.test; set +a; pnpm prisma migrate deploy && pnpm prisma generate && pnpm vitest run tests/integration'"
    },
    "dependencies": {
        "@prisma/adapter-pg": "^7.1.0",
        "@prisma/client": "^7.1.0",
        "@radix-ui/react-dropdown-menu": "^2.1.16",
        "@radix-ui/react-label": "^2.1.8",
        "@radix-ui/react-slot": "^1.2.4",
        "@testing-library/react": "^16.3.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "dotenv": "^17.2.3",
        "framer-motion": "^12.23.26",
        "lucide-react": "^0.556.0",
        "next": "16.0.10",
        "next-themes": "^0.4.6",
        "pg": "^8.16.3",
        "react": "19.2.3",
        "react-dom": "19.2.3",
        "react-hook-form": "^7.68.0",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.4.0",
        "tailwindcss-animate": "^1.0.7",
        "tldts": "^7.0.19",
        "zod": "^4.1.13"
    },
    "devDependencies": {
        "@tailwindcss/postcss": "^4.1.18",
        "@testing-library/jest-dom": "^6.9.1",
        "@types/node": "^20.19.26",
        "@types/react": "^19.2.7",
        "@types/react-dom": "^19.2.3",
        "@vitest/coverage-v8": "^4.0.16",
        "dotenv-cli": "^11.0.0",
        "eslint": "^9.39.1",
        "eslint-config-next": "16.0.8",
        "jsdom": "^27.4.0",
        "prettier": "^3.7.4",
        "prisma": "^7.1.0",
        "tailwindcss": "^4.1.18",
        "tsx": "^4.21.0",
        "tw-animate-css": "^1.4.0",
        "typescript": "^5.9.3",
        "vite-tsconfig-paths": "^6.0.3",
        "vitest": "^4.0.16"
    }
}
