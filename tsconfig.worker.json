{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": false,
        "outDir": "dist",
        "rootDir": ".",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "target": "ES2020",
        "sourceMap": true
    },
    "include": ["worker/**/*.ts", "lib/**/*.ts", "dal/**/*.ts", "generated/**/*.ts", "prisma/**/*.ts"],
    "exclude": ["node_modules", ".next", "dist"]
}

