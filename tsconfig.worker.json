{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": false,
        "outDir": "dist",
        "rootDir": ".",
        "module": "ES2020",
        "moduleResolution": "Bundler",
        "target": "ES2020",
        "sourceMap": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true
    },
    "include": ["worker/**/*.ts", "lib/**/*.ts", "dal/**/*.ts", "generated/**/*.ts", "prisma/**/*.ts"],
    "exclude": ["node_modules", ".next", "dist"],
    "tsc-alias": {
        "resolveFullPaths": true,
        "replacers": {
            "pathsReplacer": {
                "pattern": "^(.*)$",
                "replacement": "$1.js"
            }
        }
    }
}
