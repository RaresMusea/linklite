generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum DomainSource {
  RDAP
  WHOIS
  UNKNOWN
}

enum DomainStatus {
  OK
  MISSING
  REDACTED
  ERROR
  UNSUPPORTED
  UNKNOWN
}

enum DomainEnrichmentJobStatus {
  PENDING
  RUNNING
  DONE
  ERROR
}

enum LinkEnrichmentJobStatus {
  PENDING
  RUNNING
  DONE
  ERROR
}

model Link {
  id        String   @id @default(cuid())
  slug      String   @unique
  targetUrl String   @map("target_url")
  clicks    Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  ownerId   String?  @map("owner_id") // WILL BE USED LATER ON

  // Redirect / shortener enrichment (URL-level)
  isShortener        Boolean?  @map("is_shortener")
  redirectTargetUrl  String?   @map("redirect_target_url")
  redirectStatusCode Int?      @map("redirect_status_code")
  redirectCheckedAt  DateTime? @map("redirect_checked_at")

  domainId          String?            @map("domain_id")
  domain            Domain?            @relation(fields: [domainId], references: [id])
  linkEnrichmentJob LinkEnrichmentJob?
}

model Domain {
  id       String @id @default(cuid())
  hostname String @unique

  firstSeenAt DateTime @default(now()) @map("first_seen_at")

  // Derived, provider-agnostic
  registeredAt DateTime?    @map("registered_at") // domain registration date
  checkedAt    DateTime?    @map("checked_at") // last time we checked registration data
  source       DomainSource @default(UNKNOWN) @map("source")
  status       DomainStatus @default(UNKNOWN) @map("status")

  // RDAP cache
  rdapRaw       Json?     @map("rdap_raw")
  rdapFetchedAt DateTime? @map("rdap_fetched_at")

  // WHOIS cache
  whoisRaw       String?   @map("whois_raw")
  whoisFetchedAt DateTime? @map("whois_fetched_at")

  rdapFetchLockedUntil  DateTime? @map("rdap_fetch_locked_until")
  whoisFetchLockedUntil DateTime? @map("whois_fetch_locked_until")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  links                Link[]
  domainEnrichmentJobs DomainEnrichmentJob[]
}

model DomainEnrichmentJob {
  id       String @id @default(cuid())
  domainId String @unique @map("domain_id")

  status    DomainEnrichmentJobStatus @default(PENDING) @map("status")
  runAfter  DateTime                  @default(now()) @map("run_after")
  attempts  Int                       @default(0)
  lastError String?                   @map("last_error")

  lockedUntil DateTime? @map("locked_until")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  domain Domain @relation(fields: [domainId], references: [id])

  @@index([lockedUntil])
  @@index([status, runAfter])
}

model LinkEnrichmentJob {
  id     String @id @default(cuid())
  linkId String @unique @map("link_id")

  status    LinkEnrichmentJobStatus @default(PENDING) @map("status")
  runAfter  DateTime                @default(now()) @map("run_after")
  attempts  Int                     @default(0)
  lastError String?                 @map("last_error")

  lockedUntil DateTime? @map("locked_until")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  link Link @relation(fields: [linkId], references: [id])

  @@index([lockedUntil])
  @@index([status, runAfter])
}

model AnonActor {
  anonId         String   @id @default(uuid()) @map("anon_id")
  createdCount   Int      @default(0) @map("created_count")
  firstSeenAt    DateTime @default(now()) @map("first_seen_at")
  lastSeenAt     DateTime @updatedAt @map("last_seen_at")
  lastIpAddrHash String?  @map("last_ip_addr_hash")

  // Optional v2 (daily/monthly quota)
  // windowStartAt DateTime? @map("window_start_at")
  // windowCount   Int       @default(0) @map("window_count")

  @@index([lastSeenAt])
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  @@unique([email])
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}
